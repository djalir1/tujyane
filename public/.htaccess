# TUJYANE — Apache/Namecheap SPA fallback.
#
# React Router uses BrowserRouter, so paths like /admin, /search, /journeys/xyz
# are handled client-side. On Apache, requests for those paths would otherwise
# 404 because there is no file at that URL. This rewrites every non-file,
# non-directory request to index.html so the SPA can route it internally.

Options -MultiViews
RewriteEngine On
RewriteBase /

# Serve real files/directories as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else → index.html
RewriteRule ^ index.html [L]

# Cache hashed assets aggressively; index.html not at all.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot|png|jpg|jpeg|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip common text types.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
